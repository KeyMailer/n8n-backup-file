    {
      "parameters": {
        "jsCode": "// n8n Code node — \"Run Once for All Items\"\n\nfunction decodeHtml(str) {\n  return str\n    .replace(/&quot;/g, '\"')\n    .replace(/&#039;/g, \"'\")\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .trim();\n}\n\nfunction parseBlocks(html) {\n  const results = [];\n  const blocks = html.split('<div data-panel=').slice(1);\n\n  for (const block of blocks) {\n    const appIdMatch = block.match(/data-ds-appid=\"(\\d+)\"/);\n    const nameMatch = block.match(/alt=\"([^\"]+)\"/);\n    const urlMatch = block.match(/href=\"([^\"]+)\"\\s+class=\"recommendation_link\"/);\n    const recTypeMatch = block.match(/color_(not_)?recommended['\"]?>([^<]+)</);\n    const descMatch = block.match(/recommendation_desc\">\\s*([\\s\\S]*?)\\s*<\\/div>/);\n\n    if (!appIdMatch) continue;\n\n    results.push({\n      app_id: appIdMatch[1],\n      name: nameMatch ? decodeHtml(nameMatch[1]) : null,\n      recommendation: recTypeMatch ? decodeHtml(recTypeMatch[2]) : null,\n      description: descMatch ? decodeHtml(descMatch[1]) : null,\n      url: urlMatch ? decodeHtml(urlMatch[1]) : null,\n    });\n  }\n  return results;\n}\n\nconst allItems = $input.all();\nconst allResults = [];\n\nfor (const item of allItems) {\n  const raw = item.json;\n  const page = Array.isArray(raw) ? raw[0] : raw;\n  const html = page.results_html || '';\n  allResults.push(...parseBlocks(html));\n}\n\nreturn allResults.map(r => ({ json: r }));"
      },
