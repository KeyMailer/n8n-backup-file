        5312
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const err = item.json.error || item.json;\n  const message = (err && (err.message || err.description)) || 'Serper request failed';\n  return { json: { ok: false, error: 'upstream_error', message } };\n});"
      },
