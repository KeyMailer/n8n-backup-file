    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const organic = item.json.organic || [];\n  if (!organic.length) {\n    return { json: { ok: false, error: 'no_results', message: 'Serper returned no organic results for this query.' } };\n  }\n  const top = organic[0];\n  return { json: { ok: true, title: top.title || '', link: top.link || '', snippet: top.snippet || '' } };\n});"
      },
      "id": "aec19338-64b4-4a62-8ac2-0a3e5e901090",
      "name": "EXTRACT TOP RESULT",
