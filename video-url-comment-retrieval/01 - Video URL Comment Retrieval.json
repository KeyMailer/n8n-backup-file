    {
      "parameters": {
        "jsCode": "// Flatten YouTube commentThreadListResponse pages into simple comment objects\n\nconst output = [];\n\n// Loop through each input item (each item = one page/response from previous node)\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Handle case where the previous node outputs each page as its own item,\n  // and each page has an \"items\" array of commentThreads\n  const threads = data.items || [];\n\n  for (const thread of threads) {\n    const snippet = thread?.snippet?.topLevelComment?.snippet;\n\n    if (!snippet) continue;\n\n    output.push({\n      json: {\n        comments: snippet.textOriginal,\n        author_display_name: snippet.authorDisplayName,\n        author_id: snippet.authorChannelId?.value\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
