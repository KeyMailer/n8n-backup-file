      "id": "ec3cedc0-fbc4-48e1-9231-62db9354d4b0",
      "name": "SOCIAL IDENTIFICATION"
    },
    {
      "parameters": {
        "jsCode": "// n8n Code node - \"Run Once for All Items\" mode\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const url = item.json.url || '';\n  const sheetUrl = item.json.sheetUrl || '';\n  let social = 'invalid';\n\n  if (/(?:youtube\\.com|youtu\\.be)/i.test(url)) {\n    social = 'youtube';\n  } else if (/twitch\\.tv/i.test(url)) {\n    social = 'twitch';\n  }\n\n  results.push({\n    json: {\n      url,\n      sheetUrl,\n      social\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
