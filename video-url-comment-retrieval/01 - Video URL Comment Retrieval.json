    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const url = item.json.url || \"\";\n  const isVOD = url.includes(\"/videos\");\n\n  return {\n    json: {\n      ...item.json,\n      isVOD: isVOD\n    }\n  };\n});"
      },
