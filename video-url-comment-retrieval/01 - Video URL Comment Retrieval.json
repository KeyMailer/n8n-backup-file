      "name": "TWITCH: FIELD NAMING CONVENTION",
      "notes": "these fields should match with column in sheet they configure in google sheet"
    },
    {
      "parameters": {
        "jsCode": "// Get data from the \"YT: VALIDATE URL\" node (previous-previous node)\nconst validateData = $('YT: VALIDATE URL').first().json;\n\n// Splice the gid out of the sheetUrl\n// e.g. https://docs.google.com/spreadsheets/d/.../edit?gid=596025108#gid=596025108\nconst gidMatch = validateData.sheetUrl.match(/gid=(\\d+)/);\nconst sheetUrlgid = gidMatch ? gidMatch[1] : null;\n\n// Get comment items from the immediately previous node\nconst items = $input.all();\n\n// Merge validate data onto each comment item\nreturn items.map(item => {\n  return {\n    json: {\n      url: validateData.url,\n      sheetUrl: validateData.sheetUrl,\n      sheetUrlgid: sheetUrlgid,\n      social: validateData.social,\n      isVOD: validateData.isVOD,\n      comments: item.json.comments,\n      author_display_name: item.json.author_display_name,\n      author_id: item.json.author_id\n    }\n  };\n});"
      },
