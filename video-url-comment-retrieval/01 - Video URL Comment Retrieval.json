    {
      "parameters": {
        "jsCode": "// n8n Code node — Run Once for All Items\n// Normalizes Twitch VOD chat export → one item per comment\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  // Upstream may arrive as the object itself or wrapped in an array\n  const records = Array.isArray(item.json) ? item.json : [item.json];\n\n  for (const record of records) {\n    const streamer = record.streamer || {};\n    const video = record.video || {};\n    const comments = record.comments || [];\n\n    for (const comment of comments) {\n      const commenter = comment.commenter || {};\n      const message = comment.message || {};\n\n     output.push({\n        json: {\n          streamer_name: streamer.name ?? null,\n          streamer_id: streamer.id ?? null,\n          \"video title\": video.title ?? null,\n          \"video created at\": video.created_at ?? null,\n          \"video game\": video.game ?? null,\n          \"commenter display name\": commenter.display_name ?? null,\n          body: message.body ?? null,\n        },\n      });\n    }\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2304,
        256
      ],
      "id": "7466a21d-efbf-4f42-9a4a-e8ea70b295ad",
      "name": "TWITCH: FLATTEN JSON",
      "notes": "flatten the json structure and only retrieve the necessary field\n\nDocument format:\nStreamer : {\n Streamer_name: name, \n Streamer_id: id\n}\n\nVideo : {\n Video_title: title, \n Video_created_at: created_at\n Video_viewcount: viewCount\n Video_game: game\n}\n\nComments: {\n  Commenter: {\n   Commenter_display_name: display_name, \n}\n} \n\n Message: {\n  Body: body\n}\n"
    },
