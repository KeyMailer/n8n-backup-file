    {
      "parameters": {
        "jsCode": "// --- Get the TWITCH: VALIDATE URL node (single item, 2 nodes back) ---\nconst validate = $('TWITCH: VALIDATE URL').first().json;\n\n// --- Splice the gid out of the sheetUrl ---\n// e.g. ...edit?gid=1824875887#gid=1824875887  ->  \"1824875887\"\nfunction extractGid(sheetUrl) {\n  if (!sheetUrl) return null;\n  const match = String(sheetUrl).match(/[?&#]gid=([0-9]+)/);\n  return match ? match[1] : null;\n}\nconst sheetUrlgid = extractGid(validate.sheetUrl);\n\n// --- Get the previous node data (the comments array) ---\nconst items = $input.all();\n\n// --- Merge validate data onto every comment row ---\nreturn items.map((item) => {\n  const d = item.json;\n  return {\n    json: {\n      url: validate.url,\n      sheetUrl: validate.sheetUrl,\n      sheetUrlgid: sheetUrlgid,\n      social: validate.social,\n      isVOD: validate.isVOD,\n      streamer_id: d.streamer_id,\n      streamer_name: d.streamer_name,\n      video_title: d.video_title,\n      video_created_at: d.video_created_at,\n      video_game: d.video_game,\n      commenter_display_name: d.commenter_display_name,\n      comments: d.comments,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2832,
        256
      ],
      "id": "9ae92926-107d-4276-966d-eafdbe11e830",
      "name": "TWITCH: MERGE DATA",
      "notes": "merge previous node and  TWITCH: VALIDATE URL node and extract the GID from google sheet url"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst isValidYouTubeUrl = (url) => {\n  if (!url || typeof url !== 'string') return false;\n\n  // Matches https://youtu.be/VIDEO_ID (optionally with query params like ?si=...)\n  const shortPattern = /^https:\\/\\/youtu\\.be\\/[A-Za-z0-9_-]{11}(\\?.*)?$/;\n\n  // Matches https://www.youtube.com/watch?v=VIDEO_ID (optionally with extra query params)\n  const longPattern = /^https:\\/\\/(www\\.)?youtube\\.com\\/watch\\?v=[A-Za-z0-9_-]{11}(&.*)?$/;\n\n  return shortPattern.test(url) || longPattern.test(url);\n};\n\nreturn items.map(item => {\n  const isVOD = isValidYouTubeUrl(item.json.url);\n\n  return {\n    json: {\n      ...item.json,\n      isVOD: isVOD\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
